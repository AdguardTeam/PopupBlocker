.pin {
    display: none;
    width: 30px;
    height: 30px;
    position: fixed;
    right: 8px;
    cursor: pointer;
    border-radius: 100%;
    box-shadow: var(--shadow-card);
    background-color: var(--bg-pin);
    transition: var(--t3) background-color;
    padding: 0;

    &:hover {
        background-color: var(--bg-pin-hover);
    }

    &--show {
        display: block;
    }

    & > svg {
        display: block;
        margin: auto;
    }
}
