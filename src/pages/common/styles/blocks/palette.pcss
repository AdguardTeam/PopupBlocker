/**
 * Base color scale, shared by both themes.
 *
 * Mirrors AdGuard Assistant's `src/styles/base/palette.less` so that both products
 * stay on the same set of base colors.
 *
 * These are raw values with no meaning attached — do NOT reference them outside of
 * `theme.pcss`. Use the semantic tokens defined there instead.
 */
:root {
    --gray-0: #ffffff;
    --gray-10: #f6f6f6;
    --gray-20: #e4e4e4;
    --gray-30: #d2d2d2;
    --gray-40: #c0c0c0;
    --gray-50: #a4a4a4;
    --gray-60: #7f7f7f;
    --gray-70: #5b5b5b;
    --gray-80: #3d3d3d;
    --gray-90: #1f1f1f;
    --gray-100: #000000;

    --product-primary-50: #67b279;
    --product-primary-60: #589968;

    /**
     * The translucent green used for hover states. Shared verbatim with AdGuard
     * Assistant, where it is `@assist-green02` in `src/styles/base/variables.less`;
     * Popup Blocker carried the same value as `--green02`. Used in both themes so the
     * two products highlight identically.
     */
    --green-subtle: rgba(104, 188, 113, 0.2);

    /**
     * `--green-subtle` flattened onto the two pin backgrounds. The pin floats over the host
     * page through the transparent notification iframe, so its hover color has to be opaque:
     * the translucent green would show the page through instead of the pin's own color.
     */
    --green-subtle-on-white: #e1f2e3;
    --green-subtle-on-gray-90: #2e3e2f;

    /**
     * Popup Blocker's own colors, predating the Assistant palette. Kept verbatim so that
     * light mode renders exactly as it did before the dark theme was added.
     */
    --light-page: #e6e6e6;
    --light-text: #282828;
    --light-border: rgba(197, 197, 197, 0.47);
    --light-control-border: #cccccc;
    --light-control-disabled: #f1f1f1;
    --light-green: #66b574;
    --light-green-hover: #58a273;
    --light-toast: rgba(0, 0, 0, 0.7);
    --light-input-text: #000000;
    --light-icon-color: #979797;
    --light-icon-del-color: #868686;
    --light-icon-arrow-color: #1d1d1d;
    --light-modal-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.15);
}
