/**
 * CSS icons used by the options page.
 *
 * To swap an icon, drop the new file into `src/assets/icons/` and change the one line here.
 *
 * Shared inline SVG icons live in `pages/common/components/Icons/Icons.tsx`.
 * Notifications use those components because their iframe inherits the host page's CSP,
 * which can block image URLs.
 *
 * Monochrome icons are applied with `@mixin icon-mask` (see below), which paints them with
 * `--icon-color` instead of using the color baked into the SVG. That means they follow the
 * theme automatically and need no dark-mode duplicates.
 *
 * A mask is driven by alpha, so an `opacity` attribute in the source SVG no longer dims
 * the icon's own ink — it dims how much of `--icon-color` shows through, and the token can
 * no longer fully control the icon's strength. `del` carries 0.60 opacity from its
 * `background-image` days, so it renders lighter than `tooltip`, which has none.
 */
:root {
    /* Monochrome — painted with var(--icon-color) through @mixin icon-mask */
    --icon-del: svg-load("../../../../assets/icons/del.svg");
    --icon-tooltip: svg-load("../../../../assets/icons/tooltip.svg");
    --icon-moon: svg-load("../../../../assets/icons/moon.svg");
    --icon-sun: svg-load("../../../../assets/icons/sun.svg");
}

/**
 * Paints a monochrome icon with the current theme's icon color.
 *
 * @param $icon one of the `--icon-*` tokens above, e.g. `@mixin icon-mask var(--icon-del);`
 */
@define-mixin icon-mask $icon {
    -webkit-mask-image: $icon;
    mask-image: $icon;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    background-color: var(--icon-color);
}
