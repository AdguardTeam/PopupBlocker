.alert {
    display: none;
    position: fixed;
    top: 8px;
    right: 48px;
    width: 390px;
    background-color: var(--bg-card);
    padding: 45px 20px 20px;
    box-shadow: var(--shadow-card);

    &:after {
        content: "▲";
        position: absolute;
        right: -9px;
        top: 7px;
        transform: rotate(90deg) scaleY(0.7);
        color: var(--bg-card);
    }

    &--show {
        display: block;
    }

    &__close {
        @mixin close-btn;
    }

    &__in {
        display: flex;
        align-items: center;
        margin-bottom: 35px;
    }

    &__ico {
        margin-right: 20px;

        &--windows {
            background-image: var(--icon-window);
            background-repeat: no-repeat;
            background-size: contain;
            width: 48px;
            height: 48px;
            margin-right: 20px;
        }
    }

    &__text {
        width: 258px;
    }

    &__btns {
        display: flex;
        justify-content: space-between;
        position: relative;
    }

    &__select {
        position: relative;
        width: 170px;
        @mixin select-reset;

        @mixin bnt-white;

        /**
         * The chevron sits on a pseudo-element rather than on the button itself:
         * a `mask-image` on the button would clip its label away.
         */
        &:after {
            content: "";
            position: absolute;
            right: 7px;
            top: 50%;
            margin-top: -3px;
            width: 10px;
            height: 8px;
            @mixin icon-mask var(--icon-arrow);

            background-color: var(--icon-arrow-color);
        }
    }

    &__select-list {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        margin-top: 2px;
        z-index: 1;
        background-color: var(--bg-card);
        box-shadow: var(--shadow-card);

        &[hidden] {
            display: none;
        }
    }

    &__select-item {
        display: block;
        width: 100%;
        padding: 10px 20px;
        text-align: left;
        cursor: pointer;
        word-break: break-all;
        background-color: var(--bg-card);
        transition: var(--t3) background-color;
        @mixin select-reset;

        @mixin weight-regular;

        &:hover,
        &:focus {
            background-color: var(--bg-card-hover);
        }
    }

    &__btn {
        display: block;
        width: 170px;
        @mixin ellipsis;

        @mixin bnt-white;

        &:active {
            background-color: var(--product-primary);
            color: var(--text-on-primary);
        }
    }
}
